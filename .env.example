# Todas las variables son opcionales para levantar el server en dev
# (npm run dev funciona sin .env: mongodb-memory-server no necesita URI,
# y todos los valores de abajo tienen un default o fallback inseguro
# pensado solo para desarrollo local).

# Puerto HTTP del server
PORT=3001

# Nombre de la base de datos en el mongod en memoria
DB_NAME=tododb

# "development" (default) o "production". Controla, entre otras cosas,
# si las cookies de sesión se emiten con el flag Secure (requiere HTTPS)
# y si el server exige que el secret de JWT esté seteado para arrancar.
NODE_ENV=development

# Secret para firmar el JWT del access token (única cookie de sesión, sin
# refresh token). Si no está seteado, el server arranca igual en dev con
# un secreto hardcodeado inseguro (se loguea un warning bien visible al
# arrancar) — pero en NODE_ENV=production es OBLIGATORIO: si falta, el
# server no arranca.
JWT_ACCESS_SECRET=

# Origin exacto (protocolo+host+puerto) del frontend que va a consumir la
# API con cookies (fetch/axios con credentials:'include'). Sin esta variable
# no se habilita ningún origin por CORS. Ejemplo: http://localhost:5173
CORS_ORIGIN=

# Nota: la duración del token (12hs) está hardcodeada en
# src/services/authService.js, no es configurable por env var — ver el
# comentario ahí para el motivo.

# Credenciales del admin sembrado en cada arranque (src/index.js,
# ensureAdminUser en src/services/userService.js). Necesario porque
# mongodb-memory-server borra la base en cada restart. En dev, si no están
# seteadas, se usa admin@example.com / admin1234 como default. En
# NODE_ENV=production no hay default: si faltan, simplemente no se siembra
# ningún admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
